INCLUDE inc/instruments.midica

////////////////////////////////////////
// channel 0: CTRL / MSB (vol == Expression)
////////////////////////////////////////

// set, wait, length
0: vol.wait.set(10).wait().set(20) .wait(/8) .set(30)
0: .wait.wait.set(40)
0: .length(/2).wait.set(50) .wait .set(60)

// %
0: .length(64).wait.set(0%)
0: .wait.set(100.000%)

// double
0: .double.wait.set(100%)
0: .double.wait.set(0/0)
0: .double.wait.set(127/127)
0: .double.wait.set(127/0)

// hex values
0: -:*4
0: vol.length(64).set(x00)
0: .wait.set(x7F)
0: .wait.set(x40)

// double
0: .double.wait.set(x00/x00)
0: .wait.set(x00/x7F)
0: .wait.set(x7F/x00)
0: .wait.set(x12/127)
0: .wait.set(127/x3F)


////////////////////////////////////////
// channel 1: CTRL / MSB_SIGNED (balance)
////////////////////////////////////////

// set, wait, length
1: balance.length(64).wait.set(-64)
1: .wait.set(+63)
1: .wait.set(+0)
1: .wait.set(-100%)
1: .wait.set(+100%)
1: .wait.set(-0%)

// double
1: .double.wait.set(-100%)
1: .wait.set(+100%)
1: .wait.set(+0%)
1: .wait.set(-8192)
1: .wait.set(+8191)
1: .wait.set(-0)
1: .wait.set(64/0)

////////////////////////////////////////
// channel 2: CTRL / BYTE (chorus)
////////////////////////////////////////

2: chorus.length(64).wait.set(0)
2: .wait.set(127)
2: .wait.set(0)
2: .wait.set(100%)
2: .wait.set(0%)
2: .wait.set(50%)

////////////////////////////////////////
// channel 3: CTRL / BOOLEAN (hold)
////////////////////////////////////////

3: hold.length(64).wait.on()
3: .wait.off()

////////////////////////////////////////
// channel 4: CTRL / ANY (x50 == 80)
////////////////////////////////////////

4: length(64).wait.ctrl=80.on()
4: .wait.off()
4: .wait.set(100%)
4: .wait.set(0%)
4: .wait.set(50%)
4: .wait.set(127)
4: .wait.set(0)
4: .wait.set(-100%)
4: .wait.set(-75%)
4: .wait.set(-50%)
4: .wait.set(-25%)
4: .wait.set(-0%)
4: .wait.set(+0%)
4: .wait.set(+25%)
4: .wait.set(+50%)
4: .wait.set(+75%)
4: .wait.set(+100%)
4: .wait.set(-0)
4: .wait.set(-64)
4: .wait.set(+63)
4: .wait.set(+0)

////////////////////////////////////////
// channel 5: CTRL / NONE (x7B == 123 == all notes off)
////////////////////////////////////////

5: ctrl=123.length(64).wait.on()
5: -:64
5: ctrl=x7B.length(64).wait.on()

////////////////////////////////////////
// channel 6: RPN / MSB (modulation depth range)
////////////////////////////////////////

6: mod_range.length(32).wait.set(0)
6: .wait.set(127)
6: .wait.set(0.4)
6: .wait.set(126.6)

// double
6: .double.wait.set(0)
6: .wait.set(x7F/x7F)
6: .wait.set(0.5)
6: .wait.set(64.25)
6: .wait.set(127.99219)

6: c c
6: rpn=0/5.set(64)
6: c
6: rpn=5.set(0.0)
6: c
6: rpn=0/5.double.set(12/30)
6: c
6: rpn=x00/5.set(127)
6: c
6: rpn=0/x05.set(0)
6: c
6: rpn=x00/x05.set(127)

////////////////////////////////////////
// channel 7: RPN / MSB_SIGNED (channel coarse tuning / channel fine tuning)
////////////////////////////////////////

// coarse tune
7: coarse_tune.length(32)
7:   .wait.set(-64.0)
7:   .wait.set(-12)
7:   .wait.set(-1.0)
7:   .wait.set(+0)
7:   .wait.set(+1)
7:   .wait.set(+12.0)
7:   .wait.set(+63)
7: c:2

// coarse tune (generic RPN)
7: rpn=0/2.set(+12.0)
7: c:4
7: rpn=2.set(-0.0)
7: c:4

// fine tune (single, percentage)
7: fine_tune.length(32)
7:   .wait.set(-100%)
7:   .wait.set(-50.0%)
7:   .wait.set(-0.0%)
7:   .wait.set(+50%)
7:   .wait.set(+100.0%)

// fine tune (single, halftones)
7:   .wait.set(-1.0)
7:   .wait.set(-0.5)
7:   .wait.set(-0)
7:   .wait.set(+0.5)
7:   .wait.set(+1.0)

// fine tune (double, percentage)
7: .double
7:   .wait.set(-100.0%)
7:   .wait.set(-50%)
7:   .wait.set(+0.0%)
7:   .wait.set(+50.0%)
7:   .wait.set(+100%)

// fine tune (double, halftones)
7:   .wait.set(-1.0)
7:   .wait.set(-0.5)
7:   .wait.set(-0)
7:   .wait.set(+0.5)
7:   .wait.set(+1.0)
7: c:1

// fine tune (generic RPN)
7: rpn=0/1.double.set(+0.5)
7: c:4
7: rpn=1.double.set(+0.0)

////////////////////////////////////////
// channel 8: NRPN / 4/7 (+ RPNs)
////////////////////////////////////////

8: nrpn=4/7.length(32).wait.double.set(100%)
8: c
8: nrpn=519.length(32).wait.double.set(50%)       // MSB * 128 + LSB == 128 * 4 + 7 == 512 + 7 == 519
8: c
8: nrpn=4/7.length(32).wait.double.set(127/64)

////////////////////////////////////////
// channel 10: reverb
////////////////////////////////////////

10: reverb.length(64)
10:   .wait.set(-0)
10:   .wait.set(+0)
10:   .wait().set(-100%)
10:   .wait().set(+100%)
10:   .wait().set(-40)
10:   .wait().set(+87)
10:   .wait().set(x00)
10:   .wait().set(x7F)


